# Docker Environment Variables Example
# Copy this file to educore-backend/.env or pass variables directly to docker-compose

NODE_ENV=production
PORT=4000
TRUST_PROXY=true
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Container database hostnames (matched with docker-compose service names)
MONGO_URI=mongodb://mongodb:27017/educore_lms
REDIS_DRIVER=auto
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=replace-with-at-least-32-characters-access-secret
JWT_REFRESH_SECRET=replace-with-at-least-32-characters-refresh-secret
JWT_TOKEN_HASH_SECRET=replace-with-at-least-32-characters-token-hash-secret
JWT_ISSUER=educore
JWT_AUDIENCE=educore-lms

API_PUBLIC_URL=http://localhost:4000
CLIENT_URL=http://localhost:3000
